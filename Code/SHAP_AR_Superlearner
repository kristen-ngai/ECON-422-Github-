import shap
import pandas as pd
import matplotlib.pyplot as plt

def summarize_shap(shap_values, X_test, model_name, top_n=10):

    # Mean absolute SHAP value for each feature
    importance = pd.DataFrame({
        "Feature": X_test.columns,
        "Mean_Absolute_SHAP": abs(shap_values.values).mean(axis=0)
    })

    importance = importance.sort_values(
        "Mean_Absolute_SHAP",
        ascending=False
    ).head(top_n)

    print(f"\nTop {top_n} SHAP Features — {model_name}")
    print(importance.to_string(index=False))

    # Plot only the most important features
    plt.figure(figsize=(9, 5))
    plt.barh(
        importance["Feature"][::-1],
        importance["Mean_Absolute_SHAP"][::-1]
    )
    plt.xlabel("Mean Absolute SHAP Value")
    plt.title(f"Top {top_n} Features — {model_name}")
    plt.tight_layout()
    plt.show()

    return importance

