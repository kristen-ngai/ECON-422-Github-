# ============================================================
# 8. SHAP: EXPLAIN THE ACTUAL FORECAST TARGET
# ============================================================

# SHAP is run for the 1-month horizon and the full-fuel RF model.
# The model is trained on the earlier 80% and explained on the final 20%.
try:
    import shap

    shap_horizon = 1
    shap_features = FEATURE_SETS["Fare + full fuel"]

    shap_data = df.copy()
    shap_data["target"] = (
        shap_data[FARE_COL].shift(-shap_horizon)
        / shap_data[FARE_COL] - 1
    ) * 100
    shap_data = shap_data.dropna(subset=["target"]).iloc[12:]

    split_at = int(len(shap_data) * 0.8)
    shap_train = shap_data.iloc[:split_at]
    shap_test = shap_data.iloc[split_at:]

    # Purge training rows whose target extends into the test period.
    if len(shap_test):
        first_test_date = shap_test.index[0]
        shap_train = shap_train.loc[
            shap_train.index + pd.DateOffset(months=shap_horizon)
            <= first_test_date
        ]

    if len(shap_train) >= 30 and len(shap_test) >= 5:
        shap_model = RandomForestRegressor(
            n_estimators=500,
            min_samples_leaf=3,
            max_features=0.8,
            random_state=RANDOM_STATE,
            n_jobs=-1,
        )
        imputer = SimpleImputer(strategy="median")
        x_train = imputer.fit_transform(shap_train[shap_features])
        x_test = imputer.transform(shap_test[shap_features])

        shap_model.fit(x_train, shap_train["target"])

        explainer = shap.TreeExplainer(shap_model)
        shap_values = explainer.shap_values(x_test)

        plt.figure()
        shap.summary_plot(
            shap_values,
            x_test,
            feature_names=shap_features,
            show=False,
            max_display=20,
        )
        plt.tight_layout()
        plt.savefig(
            FIGURES_DIR / "shap_1m_full_fuel_forecast.png",
            dpi=300, bbox_inches="tight",
        )
        plt.close("all")
    else:
        print("Not enough data for SHAP holdout analysis.")

except ImportError:
    print("SHAP not installed; install it with: pip install shap")

