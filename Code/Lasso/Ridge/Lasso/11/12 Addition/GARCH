# ==========================================================
# GRAPH 3: SUPER LEARNER META-MODEL COEFFICIENTS
# ==========================================================

ensemble_coef_df = pd.DataFrame(
    ensemble_coefficient_records
)

if not ensemble_coef_df.empty:

    coef_summary = (
        ensemble_coef_df.groupby(
            ["Ensemble", "Base_Model"]
        )["Meta_Coefficient"]
        .mean()
        .unstack(fill_value=0)
    )

    ax = coef_summary.plot(
        kind="bar",
        figsize=(12, 6),
        width=0.8
    )

