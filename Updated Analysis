# Calculate fuel value added relative to the fare-only RF model.
rf_metrics = metrics[metrics["model"] == "Random Forest"].copy()
baseline = (
    rf_metrics[rf_metrics["feature_set"] == "Fare only"]
    [["horizon", "MAE", "RMSE"]]
    .rename(columns={"MAE": "baseline_MAE", "RMSE": "baseline_RMSE"})
)

fuel_comparison = rf_metrics.merge(baseline, on="horizon")
