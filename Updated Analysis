    (fuel_comparison["baseline_MAE"] - fuel_comparison["MAE"])
    / fuel_comparison["baseline_MAE"] * 100
)
fuel_comparison["RMSE_improvement_pct"] = (
    (fuel_comparison["baseline_RMSE"] - fuel_comparison["RMSE"])
    / fuel_comparison["baseline_RMSE"] * 100
)
